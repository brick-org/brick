{
  "name": "@brick/auth-transpiler",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "pnpm run build && node dist/file.js --write",
    "check": "pnpm run build && node dist/file.js --check && node --test dist/file.test.js && node dist/oracle.js",
    "generate:set-role": "pnpm run build && node dist/index.js --write",
    "check:set-role": "pnpm run build && node dist/index.js --check"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.3"
  }
}
